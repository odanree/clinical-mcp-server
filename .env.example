# PubMed E-utils — no auth required, but NCBI strongly recommends setting these.
# Bumps your rate limit from 3/sec to 10/sec and lets them contact you if a
# query is misbehaving. https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_API_KEY=
NCBI_TOOL_NAME=clinical-mcp-server
NCBI_EMAIL=

# OpenFDA — no auth required. Set an API key to lift the 240 calls/min limit.
# https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

LOG_LEVEL=INFO
